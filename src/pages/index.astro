---
import products from '../data/products.json';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, 1.0" />
    <title>TruePrice Club | Weekly Top 5 Curated Picks</title>
    <meta name="description" content="Direct transparent pricing on this week top 5 trending essentials." />
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen antialiased flex flex-col justify-between">
    <!-- Header -->
    <header class="border-b border-neutral-800 bg-neutral-900/60 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="h-3 w-3 rounded-full bg-emerald-400 animate-pulse"></div>
          <span class="font-extrabold tracking-tight text-xl">trueprice<span class="text-emerald-400">.club</span></span>
        </div>
        <div class="text-xs text-neutral-400 font-mono border border-neutral-700/80 px-3 py-1 rounded-full">
          Refreshed Weekly • Top 5 Drops
        </div>
      </div>
    </header>

    <!-- Hero -->
    <main class="max-w-6xl mx-auto px-6 py-12 flex-1 w-full">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight mb-4">
          The Weekly 5. <br class="hidden sm:inline" />No Fluff, Just True Value.
        </h1>
        <p class="text-neutral-400 text-sm sm:text-base leading-relaxed">
          Every week our automated sourcing engine curates the 5 highest-demand trending products, cuts out retail markups, and locks in fair, transparent prices.
        </p>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((item, index) => (
          <article class="bg-neutral-900/80 border border-neutral-800 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-neutral-700 transition duration-300">
            <div>
              <div class="relative h-64 w-full bg-neutral-800 overflow-hidden">
                <img 
                  src={item.image} 
                  alt={item.title} 
                  loading="lazy" 
                  referrerpolicy="no-referrer"
                  crossorigin="anonymous"
                  class="w-full h-full object-contain p-4 bg-white/5" 
                  onerror="if (!this.dataset.tried) { this.dataset.tried = 1; this.src = `https://images-na.ssl-images-amazon.com/images/P/${item.asin}.MAIN._SCLZZZZZZZ_SX500_.jpg`; } else { this.src = `https://placehold.co/600x400/1e293b/94a3b8?text=${encodeURIComponent(item.title.slice(0, 20))}`; }"
                />

                <span class="absolute top-3 left-3 bg-neutral-950/80 backdrop-blur border border-neutral-800 text-neutral-200 text-xs font-mono font-bold px-2.5 py-1 rounded-lg">
                  #{index + 1} Trending
                </span>
              </div>
              <div class="p-6">
                <h2 class="text-lw font-bold text-neutral-100 mb-2">{item.title}</h2>
                <p class="text-sm text-neutral-400 leading-relaxed">{item.description}</p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-neutral-800/60 mt-4">
               <div class="flex items-baseline justify-between mb-4 pt-4">
                <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Estimated Value</span>
                <span class="text-lg font-bold text-amber-400">{item.priceRange || (item.sellingPrice ? `$${item.sellingPrice.toFixed(2)}` : 'See on Amazon')}</span>
              </div>
              <div>
                <a 
                  href={item.affiliateUrl || item.paypalUrl} 
                  target="_blank" 
                  rel="nofollow noopener sponsored"
                  class="w-full bg-amber-400 hover:bg-amber-300 text-neutral-950 font-bold text-sm py-3 px-4 rounded-xl text-center transition flex items-center justify-center gap-2 shadow-sm"
                >
                  <span>Check Price on Amazon</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>
    <!-- Footer -->
    <footer class="border-t border-neutral-900 bg-neutral-950 py-8 text-xs text-neutral-500">
      <div class="max-w-6xl mx-auto px-6 flex flex-col gap-4 text-center">
        <p class="text-neutral-400 text-xs max-w-3xl mx-auto leading-relaxed">
          As an Amazon Associate I earn from qualifying purchases. Product prices and availability are accurate as of the date/time indicated and are subject to change.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2 border-t border-neutral-900 pt-4">
          <span>&copy; {new Date().getFullYear()} trueprice.club. All rights reserved.</span>
          <span>Curated Amazon Bestsellers & Top Commission Discoveries</span>
        </div>
      </div>
    </footer>
  </body>
</html>
