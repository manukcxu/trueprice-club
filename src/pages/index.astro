---
import products from "../data/products.json";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>True Price Club | High-Velocity Consumer Trends</title>
  <style>
    :root {
      --bg: #0b0c10;
      --card-bg: #14171f;
      --card-border: #232733;
      --text: #f3f4f6;
      --muted: #9ca3af;
      --accent: #00d26a;
      --gold: #f59e0b;
      --btn: #f5a623;
      --btn-hover: #e09415;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      padding-bottom: 5rem;
    }

    header.site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 2rem;
      max-width: 1300px;
      margin: 0 auto;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
    }

    .brand-dot {
      width: 10px;
      height: 10px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--accent);
    }

    .badge-pill {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.45rem 1rem;
      border-radius: 9999px;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .hero {
      text-align: center;
      max-width: 800px;
      margin: 3.5rem auto 3rem;
      padding: 0 1rem;
    }

    .hero h1 {
      font-size: 3rem;
      font-weight: 850;
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
    }

    .hero p {
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.5;
    }

    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 2rem;
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .product-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      perspective: 1200px;
      transition: border-color 0.25s, box-shadow 0.25s;
    }

    .product-card:hover {
      border-color: #3b4252;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    .stage-container {
      position: relative;
      width: 100%;
      height: 270px;
      background: radial-gradient(circle at 50% 35%, #222a38 0%, #10131a 80%);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      cursor: grab;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .stage-container:active { cursor: grabbing; }

    .trending-badge {
      position: absolute;
      top: 1rem;
      left: 1rem;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(8px);
      padding: 0.28rem 0.65rem;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      color: #fff;
      z-index: 10;
    }

    .auto-rotate-badge {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(0, 210, 106, 0.15);
      border: 1px solid rgba(0, 210, 106, 0.35);
      color: #00d26a;
      padding: 0.28rem 0.65rem;
      border-radius: 9999px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      cursor: pointer;
      z-index: 10;
      transition: all 0.2s;
    }

    .auto-rotate-badge:hover { background: rgba(0, 210, 106, 0.3); }

    .object-3d-wrapper {
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform 0.12s ease-out;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .object-3d-wrapper.continuous-spin {
      animation: realisticSpin 7s infinite linear;
    }

    @keyframes realisticSpin {
      0% { transform: rotateY(0deg) rotateX(8deg); }
      50% { transform: rotateY(180deg) rotateX(-8deg); }
      100% { transform: rotateY(360deg) rotateX(8deg); }
    }

    .model-svg {
      width: 200px;
      height: 200px;
      filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.75));
      pointer-events: none;
      user-select: none;
      transform: translateZ(25px);
    }

    .card-content {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .product-title {
      font-size: 1.15rem;
      font-weight: 750;
      line-height: 1.35;
      margin-bottom: 0.75rem;
      color: #ffffff;
    }

    .product-desc {
      font-size: 0.88rem;
      color: var(--muted);
      line-height: 1.45;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .price-label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #6b7280;
    }

    .price-val {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--gold);
    }

    .cta-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      width: 100%;
      background: var(--btn);
      color: #000;
      font-weight: 750;
      font-size: 0.95rem;
      text-decoration: none;
      padding: 0.85rem;
      border-radius: 12px;
      transition: background-color 0.15s ease, transform 0.1s ease;
    }

    .cta-button:hover {
      background: var(--btn-hover);
      transform: translateY(-1px);
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="brand">
      <div class="brand-dot"></div>
      trueprice.club
    </div>
    <div class="badge-pill">Refreshed Weekly • Live 3D Trends</div>
  </header>

  <section class="hero">
    <h1>The Weekly 5.<br>No Fluff, Just True Value.</h1>
    <p>Every week our automated sourcing engine curates the highest-demand trending products, cuts out retail markups, and locks in fair, transparent prices.</p>
  </section>

  <main class="catalog-grid">
    {products.map((item, index) => {
      const asin = item.asin;

      return (
        <article class="product-card">
          <div class="stage-container" data-stage>
            <span class="trending-badge">#{index + 1} Trending</span>
            <button class="auto-rotate-badge" data-rotate-btn type="button">↻ 3D SPIN</button>

            <div class="object-3d-wrapper" data-object>
              
              {asin === "B08N5WRWNW" && (
                <svg viewBox="0 0 200 200" class="model-svg">
                  <defs>
                    <radialGradient id={`g-at-metal-${index}`} cx="35%" cy="30%" r="70%">
                      <stop offset="0%" stop-color="#ffffff"/>
                      <stop offset="40%" stop-color="#cbd5e1"/>
                      <stop offset="80%" stop-color="#64748b"/>
                      <stop offset="100%" stop-color="#334155"/>
                    </radialGradient>
                    <radialGradient id={`g-at-gloss-${index}`} cx="40%" cy="35%" r="60%">
                      <stop offset="0%" stop-color="#ffffff"/>
                      <stop offset="75%" stop-color="#f8fafc"/>
                      <stop offset="100%" stop-color="#cbd5e1"/>
                    </radialGradient>
                  </defs>
                  <circle cx="100" cy="100" r="75" fill={`url(#g-at-metal-${index})`}/>
                  <circle cx="100" cy="100" r="60" fill={`url(#g-at-gloss-${index})`}/>
                  <circle cx="100" cy="100" r="14" fill="#94a3b8" opacity="0.3"/>
                  <path d="M86 100 A14 14 0 0 1 114 100" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              )}

              {asin === "B07FZ8S74R" && (
                <svg viewBox="0 0 200 200" class="model-svg">
                  <defs>
                    <linearGradient id={`g-bat-${index}`} x1="0%" y1="0%" x2="1" y2="1">
                      <stop offset="0%" stop-color="#334155"/>
                      <stop offset="40%" stop-color="#1e293b"/>
                      <stop offset="100%" stop-color="#090d16"/>
                    </linearGradient>
                  </defs>
                  <rect x="52" y="25" width="96" height="150" rx="18" fill={`url(#g-bat-${index})`} stroke="#475569" stroke-width="2"/>
                  <rect x="66" y="44" width="68" height="38" rx="8" fill="#020617" stroke="#1e293b"/>
                  <text x="100" y="68" fill="#38bdf8" font-size="16" font-family="monospace" font-weight="bold" text-anchor="middle">100%</text>
                  <text x="100" y="76" fill="#0284c7" font-size="7" font-family="sans-serif" font-weight="bold" text-anchor="middle">IQ FAST CHARGE</text>
                  <circle cx="82" cy="155" r="4" fill="#10b981"/>
                  <rect x="102" y="152" width="20" height="7" rx="2" fill="#334155"/>
                </svg>
              )}

              {asin === "B079V3DZ58" && (
                <svg viewBox="0 0 200 200" class="model-svg">
                  <defs>
                    <linearGradient id={`g-dryer-${index}`} x1="0%" y1="0%" x2="1" y2="0">
                      <stop offset="0%" stop-color="#f43f5e"/>
                      <stop offset="50%" stop-color="#e11d48"/>
                      <stop offset="100%" stop-color="#9f1239"/>
                    </linearGradient>
                  </defs>
                  <rect x="62" y="20" width="76" height="76" rx="16" fill="#18181b" stroke="#f43f5e" stroke-width="2.5"/>
                  <path d="M70 34 H130 M70 48 H130 M70 62 H130 M70 76 H130 M70 90 H130" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round"/>
                  <path d="M84 96 L88 175 L112 175 L116 96 Z" fill={`url(#g-dryer-${index})`} stroke="#3f3f46"/>
                  <rect x="92" y="125" width="16" height="24" rx="4" fill="#18181b"/>
                </svg>
              )}

              {asin === "B091H1KPJG" && (
                <svg viewBox="0 0 200 200" class="model-svg">
                  <defs>
                    <linearGradient id={`g-brita-body-${index}`} x1="0%" y1="0%" x2="1" y2="0%">
                      <stop offset="0%" stop-color="#e0f2fe" stop-opacity="0.7"/>
                      <stop offset="50%" stop-color="#bae6fd" stop-opacity="0.4"/>
                      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.6"/>
                    </linearGradient>
                    <linearGradient id={`g-brita-water-${index}`} x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.5"/>
                      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.8"/>
                    </linearGradient>
                  </defs>
                  <path d="M68 55 L75 168 Q78 180 92 180 L128 180 Q142 180 145 168 L152 55 Z" fill={`url(#g-brita-body-${index})`} stroke="#7dd3fc" stroke-width="2"/>
                  <path d="M73 115 L75 168 Q78 180 92 180 L128 180 Q142 180 145 168 L147 115 Q110 118 73 115 Z" fill={`url(#g-brita-water-${index})`}/>
                  <path d="M82 60 L85 105 L135 105 L138 60 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5"/>
                  <rect x="100" y="85" width="20" height="25" rx="3" fill="#94a3b8"/>
                  <path d="M60 55 Q110 42 160 55 L156 64 Q110 52 64 64 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5"/>
                  <path d="M156 54 L168 51 L160 62 Z" fill="#ffffff"/>
                  <path d="M64 65 C32 75 32 155 72 162" fill="none" stroke="#ffffff" stroke-width="11" stroke-linecap="round"/>
                </svg>
              )}

              {asin === "B07XJ8C8F5" && (
                <svg viewBox="0 0 200 200" class="model-svg">
                  <defs>
                    <linearGradient id={`g-bees-body-${index}`} x1="0%" y1="0%" x2="1" y2="0%">
                      <stop offset="0%" stop-color="#fef08a"/>
                      <stop offset="35%" stop-color="#facc15"/>
                      <stop offset="85%" stop-color="#eab308"/>
                      <stop offset="100%" stop-color="#a16207"/>
                    </linearGradient>
                    <linearGradient id={`g-bees-back-${index}`} x1="0%" y1="0%" x2="1" y2="0%">
                      <stop offset="0%" stop-color="#fde047"/>
                      <stop offset="50%" stop-color="#eab308"/>
                      <stop offset="100%" stop-color="#854d0e"/>
                    </linearGradient>
                  </defs>
                  <g transform="translate(18, -4) rotate(14 110 110)">
                    <rect x="98" y="45" width="30" height="115" rx="6" fill={`url(#g-bees-back-${index})`} stroke="#713f12" stroke-width="1.5"/>
                    <rect x="98" y="45" width="30" height="26" rx="5" fill="#ca8a04"/>
                    <rect x="98" y="148" width="30" height="12" rx="2" fill="#fef9c3"/>
                  </g>
                  <g transform="translate(-12, 6)">
                    <rect x="70" y="38" width="34" height="125" rx="7" fill={`url(#g-bees-body-${index})`} stroke="#713f12" stroke-width="1.8"/>
                    <rect x="70" y="66" width="34" height="24" fill="#dc2626"/>
                    <text x="87" y="82" fill="#ffffff" font-size="8" font-weight="900" font-family="sans-serif" text-anchor="middle">BURT'S</text>
                    <rect x="70" y="38" width="34" height="28" rx="6" fill="#fde047" stroke="#a16207" stroke-width="1.2"/>
                    <rect x="70" y="151" width="34" height="12" rx="3" fill="#fef08a" stroke="#ca8a04" stroke-width="1"/>
                    <text x="87" y="125" fill="#713f12" font-size="9" font-weight="bold" font-family="sans-serif" transform="rotate(-90 87 125)" text-anchor="middle">BEESWAX</text>
                  </g>
                </svg>
              )}

              {asin === "B0756CYWWD" && (
                <svg viewBox="0 0 200 200" class="model-svg">
                  <defs>
                    <linearGradient id={`g-tile-${index}`} x1="0%" y1="0%" x2="1" y2="1">
                      <stop offset="0%" stop-color="#ffffff"/>
                      <stop offset="60%" stop-color="#f1f5f9"/>
                      <stop offset="100%" stop-color="#cbd5e1"/>
                    </linearGradient>
                  </defs>
                  <rect x="45" y="45" width="110" height="110" rx="26" fill={`url(#g-tile-${index})`} stroke="#94a3b8" stroke-width="2"/>
                  <circle cx="70" cy="70" r="12" fill="#10131a" stroke="#cbd5e1" stroke-width="3"/>
                  <circle cx="108" cy="108" r="22" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="1.5"/>
                  <text x="108" y="113" fill="#64748b" font-size="14" font-weight="bold" font-family="sans-serif" text-anchor="middle">tile</text>
                </svg>
              )}

            </div>
          </div>

          <div class="card-content">
            <h2 class="product-title">{item.title}</h2>
            <p class="product-desc">{item.description}</p>
            
            <div class="price-row">
              <span class="price-label">ESTIMATED VALUE</span>
              <span class="price-val">{item.priceBenchmark || "See on Amazon"}</span>
            </div>

            <a href={item.affiliateUrl} target="_blank" rel="noopener noreferrer nofollow" class="cta-button">
              Check Price on Amazon ↗
            </a>
          </div>
        </article>
      );
    })}
  </main>

  <script>
    function initInteractive3D() {
      const cards = document.querySelectorAll(".product-card");

      cards.forEach((card) => {
        const stage = card.querySelector("[data-stage]");
        const obj = card.querySelector("[data-object]");
        const rotateBtn = card.querySelector("[data-rotate-btn]");
        if (!stage || !obj || !rotateBtn) return;

        rotateBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          obj.classList.toggle("continuous-spin");
          if (obj.classList.contains("continuous-spin")) {
            obj.style.transform = "";
            rotateBtn.textContent = "⏸ PAUSE";
            rotateBtn.style.color = "#38bdf8";
            rotateBtn.style.borderColor = "#38bdf8";
          } else {
            rotateBtn.textContent = "↻ 3D SPIN";
            rotateBtn.style.color = "";
            rotateBtn.style.borderColor = "";
          }
        });

        stage.addEventListener("mousemove", (e) => {
          if (obj.classList.contains("continuous-spin")) return;
          const rect = stage.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const midX = rect.width / 2;
          const midY = rect.height / 2;

          const rotY = ((x - midX) / midX) * 32;
          const rotX = -((y - midY) / midY) * 26;

          obj.style.transform = "rotateX(" + rotX.toFixed(2) + "deg) rotateY(" + rotY.toFixed(2) + "deg) scale(1.08)";
        });

        stage.addEventListener("mouseleave", () => {
          if (!obj.classList.contains("continuous-spin")) {
            obj.style.transform = "rotateX(0deg) rotateY(0deg) scale(1)";
          }
        });
      });
    }

    initInteractive3D();
  </script>
</body>
</html>